<com.google.android.material.button.MaterialButton android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="44dp" android:text="@string/stop" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="14sp" app:backgroundTint="#C0392B" app:cornerRadius="22dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/btnSlow" app:layout_constraintStart_toStartOf="parent" android:layout_marginEnd="6dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSlow" android:layout_width="0dp" android:layout_height="44dp" android:text="@string/slow" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="14sp" app:backgroundTint="#1A4A7A" app:cornerRadius="22dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/btnFast" app:layout_constraintStart_toEndOf="@id/btnStop" android:layout_marginEnd="6dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnFast" android:layout_width="0dp" android:layout_height="44dp" android:text="@string/fast" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="14sp" app:backgroundTint="#1A4A7A" app:cornerRadius="22dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/btnSlow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<!--  Sliders area  -->
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/levelsLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="32dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
<!--  Brightness card  -->
<com.google.android.material.card.MaterialCardView android:id="@+id/brightnessCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" app:cardBackgroundColor="#14224466" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="#33ffffff" app:strokeWidth="1dp" app:layout_constraintEnd_toStartOf="@id/ctCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:paddingBottom="20dp">
<TextView android:id="@+id/tvLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#ffffff" android:textSize="22sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<SeekBar android:id="@+id/level_seekbar" android:layout_width="160dp" android:layout_height="44dp" android:layout_marginTop="16dp" android:layout_marginBottom="80dp" android:maxHeight="44dp" android:minHeight="44dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:progress="40" android:progressDrawable="@drawable/level_seekbar" android:rotation="90" android:splitTrack="false" android:thumb="@android:color/white" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvLevel" app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
<!--  Colour temp card  -->
<com.google.android.material.card.MaterialCardView android:id="@+id/ctCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" app:cardBackgroundColor="#14224466" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="#33ffffff" app:strokeWidth="1dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/brightnessCard" app:layout_constraintTop_toTopOf="parent">
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:paddingBottom="20dp">
<TextView android:id="@+id/tvColourTemperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2700K" android:textColor="#FFD080" android:textSize="22sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<SeekBar android:id="@+id/colour_temperature_seekbar" android:layout_width="160dp" android:layout_height="44dp" android:layout_marginTop="16dp" android:layout_marginBottom="80dp" android:maxHeight="44dp" android:minHeight="44dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:progress="40" android:progressDrawable="@drawable/colour_temperature_seekbar" android:rotation="90" android:splitTrack="false" android:thumb="@android:color/white" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvColourTemperature" app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
