<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/colorPrimaryDark" tools:context="com.aurora.aonev3.ui.fragments.pairing.PairingFragment">
<!--  Header  -->
<TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="24dp" android:layout_marginEnd="24dp" android:text="@string/pairing" android:textColor="@color/colorTextPrimary" android:textSize="22sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<TextView android:id="@+id/tvSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="8dp" android:layout_marginEnd="24dp" android:text="@string/discovery_of_devices" android:textColor="#99ffffff" android:textSize="14sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvTitle"/>
<!--  Searching state  -->
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layoutSearching" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toTopOf="@id/btnFinish" app:layout_constraintTop_toBottomOf="@id/tvSubtitle">
<com.airbnb.lottie.LottieAnimationView android:id="@+id/animation_view" android:layout_width="200dp" android:layout_height="200dp" app:layout_constraintBottom_toTopOf="@+id/tvSearching" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_chainStyle="packed" app:layout_constraintVertical_bias="0.45" app:lottie_autoPlay="true" app:lottie_loop="true" app:lottie_rawRes="@raw/loader"/>
<TextView android:id="@+id/tvSearching" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/searching_for_devices" android:textColor="@color/colorTextPrimary" android:textSize="16sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/animation_view" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
<!--  Discovered devices list  -->
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layoutDiscovered" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toTopOf="@id/btnFinish" app:layout_constraintTop_toBottomOf="@id/tvSubtitle">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDiscoveredDevices" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:clipToPadding="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
<!--  Bottom buttons  -->
<Button android:id="@+id/btnFinish" style="@style/Button.Accent" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_marginEnd="24dp" android:layout_marginBottom="24dp" android:text="@string/finish_pairing" android:textAllCaps="false" android:textSize="15sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/btnInstructions"/>
<Button android:id="@+id/btnInstructions" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="24dp" android:layout_marginEnd="8dp" android:layout_marginBottom="24dp" android:text="@string/pairing_help" android:textAllCaps="false" android:textColor="@color/colorTextPrimary" android:textSize="15sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/btnFinish" app:layout_constraintStart_toStartOf="parent" app:strokeColor="#33ffffff"/>
</androidx.constraintlayout.widget.ConstraintLayout>